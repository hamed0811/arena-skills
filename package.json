{
  "name": "enterprise-budget-system",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Financial Budget System - Node.js/Express/SQLite backend with a CSP-hardened vanilla JS frontend.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
